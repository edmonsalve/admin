/**
 * Carga asíncrona de módulos del dashboard CME
 * Para mejorar el tiempo de carga inicial
 */

class DashboardAsync {
    constructor() {
        this.timeouts = {
            ayudSocial: 8000,
            personal: 8000,
            pcir: 8000,
            patentes: 8000
        };
        
        this.retryAttempts = 2;
        this.loadingElements = {};
    }

    /**
     * Inicializa la carga asíncrona de todos los módulos
     */
    init() {
        console.log('DashboardAsync.init() ejecutado');
        console.log('Configuración:', window.dashboardConfig);
        console.log('Módulos habilitados:');
        console.log('  - ayudSocial:', window.dashboardConfig?.modules?.ayudSocial);
        console.log('  - personal:', window.dashboardConfig?.modules?.personal);
        console.log('  - pCircu:', window.dashboardConfig?.modules?.pCircu);
        console.log('  - patComer:', window.dashboardConfig?.modules?.patComer);
        
        if (!window.dashboardConfig) {
            console.error('window.dashboardConfig no está definido');
            return;
        }
        
        if (!window.dashboardConfig.asyncEnabled) {
            console.log('Carga asíncrona deshabilitada');
            return;
        }
        
        console.log('Iniciando carga de módulos...');
        // Cargar módulos con delay mayor para asegurar renderizado completo del DOM
        if (window.dashboardConfig.modules.ayudSocial) {
            console.log('Cargando módulo ayudSocial...');
            setTimeout(() => this.loadAyudSocial(), 1000); // Aumentar delay
        }
        if (window.dashboardConfig.modules.personal) {
            console.log('Cargando módulo personal...');
            setTimeout(() => this.loadPersonalAusente(), 1200);
        }
        if (window.dashboardConfig.modules.pCircu) {
            console.log('Cargando módulo pCircu...');
            setTimeout(() => this.loadPcirData(), 1400);
        }
        if (window.dashboardConfig.modules.patComer) {
            console.log('Cargando módulo patComer...');
            setTimeout(() => this.loadPatentesData(), 1600);
        }
    }

    /**
     * Inicializa los estados de carga
     */
    initLoadingStates() {
        const modules = ['ayudSocial', 'personal', 'pcir', 'patentes'];
        
        modules.forEach(module => {
            const container = document.getElementById(`dashboard-${module}`);
            if (container) {
                this.showLoading(container, `Cargando datos de ${module}...`);
            }
        });
    }

    /**
     * Muestra indicador de carga sin destruir contenido existente
     */
    showLoading(container, message) {
        // Verificar si ya existe un canvas en el contenedor
        const existingCanvas = container.querySelector('canvas');
        if (existingCanvas) {
            // Si existe canvas, solo agregar overlay de loading
            this.addLoadingOverlay(container, message);
        } else {
            // Si no existe canvas, crear estructura básica con loading
            container.innerHTML = `
                <div class="loading-indicator">
                    <div class="spinner"></div>
                    <span>${message}</span>
                </div>
            `;
        }
    }

    /**
     * Agrega overlay de loading sobre contenido existente
     */
    addLoadingOverlay(container, message) {
        // Evitar múltiples overlays
        if (container.querySelector('.loading-overlay')) return;
        
        const overlay = document.createElement('div');
        overlay.className = 'loading-overlay';
        overlay.innerHTML = `
            <div class="loading-indicator">
                <div class="spinner"></div>
                <span>${message}</span>
            </div>
        `;
        overlay.style.cssText = `
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        `;
        
        // Asegurar que el contenedor tenga posición relativa
        if (getComputedStyle(container).position === 'static') {
            container.style.position = 'relative';
        }
        
        container.appendChild(overlay);
    }

    /**
     * Remueve overlay de loading
     */
    removeLoadingOverlay(container) {
        const overlay = container.querySelector('.loading-overlay');
        if (overlay) {
            overlay.remove();
        }
    }

    /**
     * Muestra mensaje de error preservando canvas existentes
     */
    showError(container, message) {
        // Verificar si ya existe un canvas en el contenedor
        const existingCanvas = container.querySelector('canvas');
        if (existingCanvas) {
            // Si existe canvas, solo agregar overlay de error
            this.addErrorOverlay(container, message);
        } else {
            // Si no existe canvas, reemplazar contenido completo
            container.innerHTML = `
                <div class="error-indicator">
                    <span class="error-icon">⚠</span>
                    <span>${message}</span>
                    <button onclick="location.reload()" class="retry-btn">Reintentar</button>
                </div>
            `;
        }
    }

    /**
     * Agrega overlay de error sobre contenido existente
     */
    addErrorOverlay(container, message) {
        // Remover loading overlay si existe
        this.removeLoadingOverlay(container);
        
        // Evitar múltiples overlays de error
        if (container.querySelector('.error-overlay')) return;
        
        const overlay = document.createElement('div');
        overlay.className = 'error-overlay';
        overlay.innerHTML = `
            <div class="error-indicator">
                <span class="error-icon">⚠</span>
                <span>${message}</span>
                <button onclick="this.parentElement.parentElement.remove(); location.reload()" class="retry-btn">Reintentar</button>
            </div>
        `;
        overlay.style.cssText = `
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        `;
        
        // Asegurar que el contenedor tenga posición relativa
        if (getComputedStyle(container).position === 'static') {
            container.style.position = 'relative';
        }
        
        container.appendChild(overlay);
    }

    /**
     * Realizar petición AJAX con timeout y retry
     */
    async makeRequest(url, timeout, retries = 0) {
        return new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            
            const timeoutId = setTimeout(() => {
                xhr.abort();
                reject(new Error('Timeout'));
            }, timeout);

            xhr.onreadystatechange = function() {
                if (xhr.readyState === 4) {
                    clearTimeout(timeoutId);
                    
                    if (xhr.status === 200) {
                        try {
                            const data = JSON.parse(xhr.responseText);
                            resolve(data);
                        } catch (e) {
                            reject(new Error('Error parsing JSON'));
                        }
                    } else {
                        reject(new Error(`HTTP ${xhr.status}`));
                    }
                }
            };

            xhr.onerror = function() {
                clearTimeout(timeoutId);
                reject(new Error('Network error'));
            };

            xhr.open('GET', url, true);
            xhr.send();
        }).catch(error => {
            if (retries < this.retryAttempts) {
                console.log(`Retrying request to ${url}, attempt ${retries + 1}`);
                return this.makeRequest(url, timeout, retries + 1);
            }
            throw error;
        });
    }

    /**
     * Cargar datos de ayuda social
     */
    async loadAyudSocial() {
        console.log('loadAyudSocial() iniciado');
        const container = document.getElementById('dashboard-ayudSocial');
        if (!container) {
            console.error('Container dashboard-ayudSocial no encontrado');
            return;
        }

        // Mostrar loading antes de hacer request
        this.showLoading(container, 'Cargando datos de ayuda social...');

        try {
            // Usar endpoint real de ayuda social
            const endpoint = '/appCme/ajax/ayudSocialData.php';
            console.log('Haciendo request a:', endpoint);
            const data = await this.makeRequest(endpoint, this.timeouts.ayudSocial);
            
            console.log('Datos recibidos:', data);
            this.renderAyudSocialChart(container, data);
        } catch (error) {
            console.error('Error loading Ayuda Social:', error);
            this.showError(container, 'Error cargando datos de Ayuda Social');
        }
    }

    /**
     * Cargar datos de personal ausente
     */
    async loadPersonalAusente() {
        const container = document.getElementById('dashboard-personal');
        if (!container) return;

        // Mostrar loading antes de hacer request
        this.showLoading(container, 'Cargando datos de personal...');

        try {
            const data = await this.makeRequest(
                '/appCme/ajax/personalAusenteData.php', 
                this.timeouts.personal
            );
            
            this.renderPersonalChart(container, data);
        } catch (error) {
            console.error('Error loading Personal:', error);
            this.showError(container, 'Error cargando datos de Personal');
        }
    }

    /**
     * Cargar datos de PCIR
     */
    async loadPcirData() {
        console.log('loadPcirData() iniciado');
        const container = document.getElementById('dashboard-pcir');
        if (!container) {
            console.error('Container dashboard-pcir no encontrado');
            return;
        }

        // Mostrar loading antes de hacer request
        this.showLoading(container, 'Cargando datos de PCIR...');

        try {
            console.log('Haciendo request a: /appCme/ajax/pcirData.php');
            const data = await this.makeRequest(
                '/appCme/ajax/pcirData.php', 
                this.timeouts.pcir
            );
            
            console.log('Datos PCIR recibidos:', data);
            this.renderPcirChart(container, data);
        } catch (error) {
            console.error('Error loading PCIR:', error);
            this.showError(container, 'Error cargando datos de PCIR');
        }
    }

    /**
     * Cargar datos de patentes
     */
    async loadPatentesData() {
        console.log('loadPatentesData() iniciado');
        const container = document.getElementById('dashboard-patentes');
        if (!container) {
            console.error('Container dashboard-patentes no encontrado');
