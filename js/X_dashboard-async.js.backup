        }
    }

    /**
     * Renderizar gráfico de ayuda social
     */
    renderAyudSocialChart(container, data) {
        console.log('renderAyudSocialChart ejecutado con:', data);
        
        // Remover overlay de loading
        this.removeLoadingOverlay(container);
        
        if (data.error) {
            console.error('Error en datos de ayuda social:', data.error);
            this.showError(container, data.error);
            return;
        }

        console.log('Intentando crear gráfico de ayuda social...');
        
        // En lugar de disparar evento, crear directamente el gráfico
        try {
            // Buscar el canvas dentro del contenedor
            const canvas = container.querySelector('#graficoAyudSocEnt');
            if (!canvas) {
                console.error('Canvas graficoAyudSocEnt no encontrado dentro del contenedor');
                this.showError(container, 'Canvas no encontrado');
                return;
            }
            
            console.log('Canvas encontrado, verificando si ya existe un gráfico...');
            
            // Destruir gráfico existente si lo hay
            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                console.log('Destruyendo gráfico existente...');
                existingChart.destroy();
            }
            
            console.log('Creando gráfico de ayuda social con datos reales...');
            
            // Usar la función original del sistema con datos reales
            if (typeof window.graficoAyudSocEnt === 'function') {
                // Llamar a la función original con los datos recibidos
                window.graficoAyudSocEnt(
                    eval('[' + data.labels + ']'),           // ayudasLabels
                    eval('[' + data.tipoAyudas + ']'),       // tipoAyudas  
                    data.ayuda01.split(',').map(Number),     // ayudas01
                    data.ayuda02.split(',').map(Number),     // ayudas02
                    data.ayuda03.split(',').map(Number),     // ayudas03
                    data.ayuda04.split(',').map(Number),     // ayudas04
                    data.ayuda05.split(',').map(Number),     // ayudas05
                    data.ayuda06.split(',').map(Number),     // ayudas06
                    data.ayuda07.split(',').map(Number),     // ayudas07
                    data.ayuda08.split(',').map(Number),     // ayudas08
                    data.ayuda09.split(',').map(Number),     // ayudas09
                    data.ayuda10.split(',').map(Number),     // ayudas10
                    data.montoAyudas.split(',').map(Number)  // montoTotal
                );
                console.log('✅ Gráfico de ayuda social creado exitosamente usando función original');
            } else {
                // Fallback: Crear gráfico básico si no hay función original
                const ctx = canvas.getContext('2d');
                
                const chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: eval('[' + data.labels + ']'),
                        datasets: [{
                            label: 'Total Ayudas',
                            data: data.montoAyudas.split(',').map(Number),
                            borderColor: '#3f51b5',
                            backgroundColor: 'rgba(63, 81, 181, 0.1)',
                            tension: 0,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'Ayudas Sociales Entregadas'
                            }
                        }
                    }
                });
                console.log('✅ Gráfico de ayuda social creado con fallback');
            }
            
            // Forzar re-render después de un pequeño delay
            setTimeout(() => {
                if (chart && chart.resize) {
                    console.log('🔄 Forzando resize del gráfico de ayuda social...');
                    chart.resize();
                    chart.update();
                }
            }, 100);
            container.classList.add('loaded');
            
        } catch (error) {
            console.error('❌ Error creando gráfico de ayuda social:', error);
            this.showError(container, 'Error creando gráfico: ' + error.message);
        }
    }

    /**
     * Renderizar gráfico de personal
     */
    renderPersonalChart(container, data) {
        console.log('renderPersonalChart ejecutado con:', data);
        
        // Remover overlay de loading
        this.removeLoadingOverlay(container);
        
        if (data.error) {
            console.error('Error en datos de personal:', data.error);
            this.showError(container, data.error);
            return;
        }

        console.log('Intentando crear gráfico de personal...');
        
        try {
            // Buscar el canvas dentro del contenedor
            const canvas = container.querySelector('#graficoPersonal');
            if (!canvas) {
                console.error('Canvas graficoPersonal no encontrado dentro del contenedor');
                this.showError(container, 'Canvas no encontrado');
                return;
            }
            
            console.log('Canvas encontrado, verificando si ya existe un gráfico...');
            
            // Destruir gráfico existente si lo hay
            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                console.log('Destruyendo gráfico existente de personal...');
                existingChart.destroy();
            }
            
            console.log('Creando nuevo gráfico de personal...');
            
            // DEBUG: Verificar estado del canvas antes de crear gráfico
            const canvasRect = canvas.getBoundingClientRect();
            const canvasStyles = window.getComputedStyle(canvas);
            console.log('🔍 CANVAS DEBUG:');
            console.log('  - Canvas dimensions:', canvasRect.width + 'x' + canvasRect.height);
            console.log('  - Canvas display:', canvasStyles.display);
            console.log('  - Canvas visibility:', canvasStyles.visibility);
            console.log('  - Canvas opacity:', canvasStyles.opacity);
            console.log('  - Container visible:', container.getBoundingClientRect().width + 'x' + container.getBoundingClientRect().height);
            
            // Verificar que el canvas tenga dimensiones válidas
            if (canvasRect.width === 0 || canvasRect.height === 0) {
                console.warn('⚠️ Canvas tiene dimensiones 0, esperando y reintentando...');
                setTimeout(() => {
                    console.log('🔄 Reintentando crear gráfico de ayuda social...');
                    this.renderAyudSocialChart(container, data);
                }, 500);
                return;
            }
            
            const ctx = canvas.getContext('2d');
            
            const chart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Presentes', 'Vacaciones', 'Permisos'],
                    datasets: [{
                        data: [
                            data.funcionariosTrabajando || 0,
                            data.funcionariosVacaciones || 0,
                            data.funcionariosPermiso || 0
                        ],
                        backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Estado del Personal'
                        },
                        legend: {
                            display: true,
                            position: 'bottom'
                        }
                    }
                }
            });
            
            console.log('✅ Gráfico de personal creado exitosamente');
            container.classList.add('loaded');
            
        } catch (error) {
            console.error('❌ Error creando gráfico de personal:', error);
            this.showError(container, 'Error creando gráfico: ' + error.message);
        }
    }

    /**
     * Renderizar gráfico de PCIR
     */
    renderPcirChart(container, data) {
        console.log('renderPcirChart ejecutado con:', data);
        
        // Remover overlay de loading
        this.removeLoadingOverlay(container);
        
        if (data.error) {
            console.error('Error en datos de PCIR:', data.error);
            this.showError(container, data.error);
            return;
        }

        console.log('Intentando crear gráficos de PCIR...');
        
        try {
            // Usar las funciones originales del sistema
            if (typeof window.graficoPcirHistorico === 'function' && typeof window.graficoPcirActivo === 'function') {
                // Gráfico histórico
                window.graficoPcirHistorico(
                    eval('[' + data.labelsPcirHistorico + ']'),    // labels
                    data.ventasContadoHist.split(',').map(Number), // ventasContadoHist
                    data.ventas1Cuota.split(',').map(Number),      // ventas1Cuota
                    data.ventas2Cuota.split(',').map(Number)       // ventas2Cuota
                );
                console.log('✅ Gráfico PCIR histórico creado usando función original');
                
                // Gráfico activo (doughnut)
                window.graficoPcirActivo(
                    data.pcirAnoActivo || "'2025'",    // año
                    data.MontoContado || 0,            // montoContado
                    data.MontoCuotas1 || 0,            // monto1raCuota
                    data.MontoCuotas2 || 0             // monto2daCuota
                );
                console.log('✅ Gráfico PCIR activo creado usando función original');
                
            } else {
                console.log('Funciones originales no encontradas, usando fallback...');
                // Fallback con datos básicos
                const canvasHistorico = container.querySelector('#graficoPcirHist');
                if (canvasHistorico) {
                    const existingChart = Chart.getChart(canvasHistorico);
                    if (existingChart) existingChart.destroy();
                    
                    const ctxHist = canvasHistorico.getContext('2d');
                    new Chart(ctxHist, {
                        type: 'line',
                        data: {
                            labels: ['2025'],
                            datasets: [{
                                label: 'PCIR Total',
                                data: [100],
                                borderColor: '#3f51b5'
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: { title: { display: true, text: 'PCIR Histórico (Datos de prueba)' }}
                        }
                    });
                    console.log('✅ Gráfico PCIR histórico (fallback) creado');
                }
            }
            } else {
                console.log('Canvas histórico encontrado, verificando gráfico existente...');
                
                // Destruir gráfico existente si lo hay
                const existingChart = Chart.getChart(canvasHistorico);
                if (existingChart) {
                    console.log('Destruyendo gráfico PCIR histórico existente...');
                    existingChart.destroy();
                }
                
                console.log('Creando nuevo gráfico PCIR histórico...');
                const ctxHist = canvasHistorico.getContext('2d');
                
                const chartHist = new Chart(ctxHist, {
                    type: 'line',
                    data: {
                        labels: [data.pcirAnoActivo?.replace(/'/g, '') || '2025'],
                        datasets: [{
                            label: 'Ventas Contado',
                            data: [data.ventasContadoHist || 0],
                            backgroundColor: 'rgba(54, 162, 235, 0.2)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 2
                        }, {
                            label: 'Ventas 1 Cuota',
                            data: [data.ventas1Cuota || 0],
                            backgroundColor: 'rgba(255, 99, 132, 0.2)',
                            borderColor: 'rgba(255, 99, 132, 1)',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'PCIR Histórico'
                            }
                        }
                    }
                });
                
                console.log('✅ Gráfico PCIR histórico creado exitosamente');
                
                // Forzar re-render después de un pequeño delay
                setTimeout(() => {
                    if (chartHist && chartHist.resize) {
                        console.log('🔄 Forzando resize del gráfico PCIR histórico...');
                        chartHist.resize();
                        chartHist.update();
                    }
                }, 100);
            }
            
            if (!canvasDoughnut) {
                console.error('Canvas miDoughnut no encontrado dentro del contenedor');
            } else {
                console.log('Canvas doughnut encontrado, verificando gráfico existente...');
                
                // Destruir gráfico existente si lo hay
                const existingChart = Chart.getChart(canvasDoughnut);
                if (existingChart) {
                    console.log('Destruyendo gráfico PCIR doughnut existente...');
                    existingChart.destroy();
                }
                
                console.log('Creando nuevo gráfico PCIR doughnut...');
                const ctxDough = canvasDoughnut.getContext('2d');
                
                const total = (data.MontoContado || 0) + (data.MontoCuotas1 || 0) + (data.MontoCuotas2 || 0);
                
                const chartDough = new Chart(ctxDough, {
                    type: 'doughnut',
                    data: {
                        labels: ['Contado', 'Cuotas 1', 'Cuotas 2'],
                        datasets: [{
                            data: [
                                data.MontoContado || 0,
                                data.MontoCuotas1 || 0, 
                                data.MontoCuotas2 || 0
                            ],
                            backgroundColor: [
                                'rgba(54, 162, 235, 0.8)',
                                'rgba(255, 99, 132, 0.8)',
                                'rgba(255, 205, 86, 0.8)'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            title: {
                                display: true,
                                text: 'PCIR Activo'
                            }
                        }
                    }
                });
                
                console.log('✅ Gráfico PCIR doughnut creado exitosamente');
                
                // Forzar re-render después de un pequeño delay  
                setTimeout(() => {
                    if (chartDough && chartDough.resize) {
                        console.log('🔄 Forzando resize del gráfico PCIR doughnut...');
                        chartDough.resize();
                        chartDough.update();
                    }
                }, 100);
            }
            
        } catch (error) {
            console.error('❌ Error creando gráficos de PCIR:', error);
            this.showError(container, 'Error creando gráfico: ' + error.message);
        }
    }

    /**
     * Renderizar gráfico de patentes
     */
    renderPatentesChart(container, data) {
        console.log('renderPatentesChart ejecutado con:', data);
        
        // Remover overlay de loading
        this.removeLoadingOverlay(container);
        
        if (data.error) {
            console.error('Error en datos de patentes:', data.error);
            this.showError(container, data.error);
            return;
        }

        console.log('Intentando crear gráfico de patentes...');
        
        try {
            // Buscar el canvas dentro del contenedor
            const canvas = container.querySelector('#graficoPatHist');
            if (!canvas) {
                console.error('Canvas graficoPatHist no encontrado dentro del contenedor');
                this.showError(container, 'Canvas no encontrado');
                return;
            }
            
            console.log('Canvas encontrado, verificando gráfico existente...');
            
            // Destruir gráfico existente si lo hay
            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                console.log('Destruyendo gráfico de patentes existente...');
                existingChart.destroy();
            }
            
            console.log('Creando nuevo gráfico de patentes...');
            
            // DEBUG: Verificar estado del canvas antes de crear gráfico
            const canvasRect = canvas.getBoundingClientRect();
            const canvasStyles = window.getComputedStyle(canvas);
            console.log('🔍 PERSONAL CANVAS DEBUG:');
            console.log('  - Canvas dimensions:', canvasRect.width + 'x' + canvasRect.height);
            console.log('  - Canvas display:', canvasStyles.display);
            console.log('  - Canvas visibility:', canvasStyles.visibility);
            console.log('  - Canvas opacity:', canvasStyles.opacity);
            console.log('  - Container visible:', container.getBoundingClientRect().width + 'x' + container.getBoundingClientRect().height);
            
            const ctx = canvas.getContext('2d');
            
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: [data.seriesPat?.replace(/'/g, '') || '2025'],
                    datasets: [{
                        label: 'Pagadas',
                        data: [data.seriePagadas || 0],
                        backgroundColor: 'rgba(75, 192, 192, 0.8)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }, {
                        label: 'Morosas',
                        data: [42],
                        backgroundColor: 'rgba(255, 99, 132, 0.8)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Patentes Comerciales'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
            
            console.log('✅ Gráfico de patentes creado exitosamente');
            
            // Forzar re-render después de un pequeño delay
            setTimeout(() => {
                if (chart && chart.resize) {
                    console.log('🔄 Forzando resize del gráfico de patentes...');
                    chart.resize();
                    chart.update();
                }
            }, 100);
            
        } catch (error) {
            console.error('❌ Error creando gráfico de patentes:', error);
            this.showError(container, 'Error creando gráfico: ' + error.message);
        }
    }
}

// Inicializar cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', function() {
    console.log('dashboard-async.js DOMContentLoaded ejecutado');
    
    // Esperar un momento para que window.dashboardConfig se establezca
    setTimeout(function() {
        if (typeof window.dashboardConfig !== 'undefined') {
            console.log('dashboardConfig encontrado:', window.dashboardConfig);
            
            if (window.dashboardConfig.asyncEnabled) {
                console.log('Inicializando DashboardAsync...');
                const dashboard = new DashboardAsync();
                dashboard.init();
            } else {
                console.log('Carga asíncrona deshabilitada, usando modo síncrono');
            }
        } else {
            console.error('window.dashboardConfig no está definido');
            // Intentar de nuevo en caso de timing issue
            setTimeout(function() {
                if (typeof window.dashboardConfig !== 'undefined') {
                    console.log('dashboardConfig encontrado en segundo intento:', window.dashboardConfig);
                    
                    if (window.dashboardConfig.asyncEnabled) {
                        const dashboard = new DashboardAsync();
                        dashboard.init();
                    }
                } else {
                    console.error('window.dashboardConfig sigue sin estar definido después de 2 segundos');
                }
            }, 2000);
        }
    }, 100);
});

// Exportar la clase para uso global
window.DashboardAsync = DashboardAsync;